# Supabase Postgres — Project Settings → Database → Connection string → URI
# Use "Direct connection" (port 5432). Replace [YOUR-PASSWORD] with your DB password.
# Example: postgresql://postgres.xxxx:password@aws-0-us-east-1.pooler.supabase.com:5432/postgres
DATABASE_URL=

# Random secret for NextAuth sessions — generate with: openssl rand -base64 32
AUTH_SECRET=

# Google OAuth — https://console.cloud.google.com/apis/credentials
# Redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
